{
	"name": "open-spaces-live",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint . --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply open-spaces-live-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply open-spaces-live-db --remote",
		"db:seed-admin": "node scripts/seed-admin.js",
		"test": "vitest run"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"hono": "^4.12.18",
		"node-addon-api": "^8.8.0",
		"node-gyp": "^12.3.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-router-dom": "^7.15.0",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.36.4",
		"@eslint/js": "^9.39.4",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"eslint": "^9.39.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.6",
		"wrangler": "^4.90.1"
	}
}
