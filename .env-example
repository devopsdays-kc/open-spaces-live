# Production secrets: set with `wrangler secret put <NAME>` — never commit real values.
# Local dev: copy this file to .dev.vars and fill in values (wrangler reads .dev.vars automatically).
# COOKIE_SECRET and ATTENDEE_SALT are REQUIRED — the worker returns 500 if either is absent.

# HMAC key used to sign attendee + facilitator cookies. 32+ random chars.
COOKIE_SECRET=replace-with-32-plus-random-chars

# Salt for hashing cf-connecting-ip in the attendees table. Rotatable per event.
ATTENDEE_SALT=replace-with-random-string

# Admin magic-link email (Mailgun).
MAILGUN_API_KEY=api_key_here
MAILGUN_DOMAIN=domain_here
MAILGUN_FROM=noreply@domain_here
